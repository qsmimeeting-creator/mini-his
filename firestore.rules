rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/userRoles/$(request.auth.uid);
    }

    function hasRoleDoc() {
      return signedIn() && exists(rolePath());
    }

    function userRole() {
      return get(rolePath()).data;
    }

    function isActiveUser() {
      return hasRoleDoc() && userRole().active == true && userRole().roles is list;
    }

    function hasAnyRole(roles) {
      return isActiveUser() && (userRole().roles.hasAny(['admin']) || userRole().roles.hasAny(roles));
    }

    function hasPermission(permission) {
      return isActiveUser()
        && (
          userRole().roles.hasAny(['admin'])
          || (userRole().permissions is list && userRole().permissions.hasAny([permission]))
        );
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function onlyChangingOwnPasswordFlag(uid) {
      return signedIn()
        && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt', 'updatedBy'])
        && request.resource.data.mustChangePassword == false
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /userRoles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || onlyChangingOwnPasswordFlag(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isActiveUser();
      allow create, update: if hasAnyRole(['register', 'nurse']);
      allow delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if isActiveUser();
      allow create: if hasAnyRole(['register']);
      allow update: if hasAnyRole(['nurse', 'doctor', 'cashier', 'stock'])
        && (
          request.resource.data.status != 'VOID'
          || hasAnyRole(['nurse'])
        );
      allow delete: if isAdmin();
    }

    match /vaccines/{vaccineId} {
      allow read: if isActiveUser();
      allow create, update, delete: if hasAnyRole(['stock']);
    }

    match /auditLogs/{auditLogId} {
      allow read: if hasAnyRole(['report']);
      allow create: if isActiveUser()
        && request.resource.data.createdAt is string
        && request.resource.data.action is string
        && request.resource.data.targetType is string;
      allow update, delete: if false;
    }

    match /metadata/{documentId} {
      allow read: if isActiveUser();
      allow create, update: if (
        documentId == 'counters' && hasAnyRole(['register'])
      ) || (
        documentId == 'opdCoverLayout' && isAdmin()
      ) || (
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
